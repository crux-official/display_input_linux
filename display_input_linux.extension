# The universal-linux windowing bundle: the display and input concerns as
# ONE implementation - the vendor-shaped unit (one dlopen-probed backend
# owns the connection; display rides it, input rides display). ONE probe,
# ONE construct, ONE archive. The implements list is the serve (one row
# per concern, at the contract level it serves); the requires are the
# package's other dependencies (the served concerns' own headers are its
# own - a serve is not a require).
format_version = 1
name   = "display_input_linux"
kind   = "implementation"
implements = [
  { concern = "display", window = "1.1.0" },
  { concern = "input",   window = "1.1.0" },
]
supported_platforms = ["linux"]
version = "1.0.0"
requires = [
  { package = "logging", window = "0.0.0" },
  { package = "memory", window = "0.0.0" },
  { package = "time", window = "0.0.0" }
]
# The dlopen user: only dl is linked (no windowing library at build time -
# the dlopen/dlsym bridge is the whole platform surface).
link_libraries = ["dl"]
