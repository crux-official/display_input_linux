format_version = 2
name   = "display_input_linux"
kind   = "implementation"
version = "2.0.0"
implements = [
  { interface = "display", window = "1.1.0" },
  { interface = "input", window = "1.1.0" },
]
requires = [
  { package = "logging", window = "1.1.0" },
  { package = "memory", window = "1.1.0" },
  { package = "time", window = "1.1.0" },
]
source   = [
  "display.c",
  "display_input_linux.c",
  "input.c",
  "lx_probe.c",
  "probe.c",
  "queue.c",
  "wayland.c",
  "x11.c",
  "x11_input.c",
]
supported_platforms = ["linux"]
link_libraries = ["dl"]
